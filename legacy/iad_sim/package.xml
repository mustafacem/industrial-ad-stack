<?xml version="1.0"?>
<package format="3">
  <name>iad_sim</name>
  <version>0.2.0</version>
  <description>Sensor-level 3D simulator for industrial / off-road AD: quarry and container-port worlds, heavy-vehicle dynamics, dual-return LiDAR with dust, GNSS multipath, IMU, wheel odometry.</description>
  <maintainer email="dev@example.com">iad</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>iad_common</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>eigen</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
