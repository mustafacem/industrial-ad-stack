<?xml version="1.0" encoding="UTF-8" ?>
<!-- Point clouds are 0.3-1 MB per sample and the latched maps/meshes 10-20 MB: give shared memory room
     (the default 512 KB segment drops large samples to fragmented UDP; 32 MB overflowed at start-up). -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_big</transport_id>
      <type>SHM</type>
      <segment_size>134217728</segment_size>
      <port_queue_capacity>1024</port_queue_capacity>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp_big</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>4194304</sendBufferSize>
      <receiveBufferSize>4194304</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="iad_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_big</transport_id>
        <transport_id>udp_big</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
