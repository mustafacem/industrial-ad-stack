#!/usr/bin/env python3
"""Scores iad_calibration's extrinsic estimates against the simulator's true sensor poses (evaluation only).

/sim/ground_truth/extrinsics (JSON: truth + nominal per frame) vs /calibration/metrics (estimates):
rotation / translation error before (nominal) and after (estimate) per LiDAR -> /eval/calibration (JSON)."""
import json

import numpy as np
import rclpy
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile
from std_msgs.msg import String


def T(xyz, rpy):
    r, p, y = rpy
    cr, sr, cp, sp, cy, sy = np.cos(r), np.sin(r), np.cos(p), np.sin(p), np.cos(y), np.sin(y)
    R = np.array([[cy * cp, cy * sp * sr - sy * cr, cy * sp * cr + sy * sr],
                  [sy * cp, sy * sp * sr + cy * cr, sy * sp * cr - cy * sr],
                  [-sp, cp * sr, cp * cr]])
    M = np.eye(4)
    M[:3, :3], M[:3, 3] = R, xyz
    return M


def err(a, b):
    d = np.linalg.inv(a) @ b
    ang = np.degrees(np.arccos(np.clip((np.trace(d[:3, :3]) - 1) / 2, -1, 1)))
    return float(ang), float(100 * np.linalg.norm(d[:3, 3]))


class CalibrationEval(Node):
    def __init__(self):
        super().__init__("calibration_eval")
        self.truth = None
        self.last = {}
        self.pub = self.create_publisher(String, "/eval/calibration", 10)
        self.create_subscription(String, "/sim/ground_truth/extrinsics", self.on_truth,
                                 QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL))
        self.create_subscription(String, "/calibration/metrics", self.on_metrics, 10)

    def on_truth(self, m):
        self.truth = json.loads(m.data)

    def on_metrics(self, m):
        if not self.truth:
            return
        j = json.loads(m.data)
        out = {"state": j.get("state"), "lidars": {}}
        for name, e in j.get("lidars", {}).items():
            frame = e.get("frame", "lidar_" + name)
            t, n = self.truth["truth"].get(frame), self.truth["nominal"].get(frame)
            if not t:
                continue
            Tt, Tn, Te = T(t["xyz"], t["rpy"]), T(n["xyz"], n["rpy"]), T(e["xyz"], e["rpy"])
            r0, t0 = err(Tn, Tt)
            r1, t1 = err(Te, Tt)
            out["lidars"][name] = {"rot_before_deg": r0, "trans_before_cm": t0, "rot_deg": r1, "trans_cm": t1,
                                   "rms_cm": e.get("rms_cm", 0),
                                   # per-axis residual (estimate - truth): roll, pitch, yaw [deg], x, y, z [cm]
                                   "axis_err": [float(np.degrees(np.remainder(e["rpy"][i] - t["rpy"][i] + np.pi, 2 * np.pi) - np.pi))
                                                for i in range(3)] + [100 * (e["xyz"][i] - t["xyz"][i]) for i in range(3)]}
        self.last = out
        self.pub.publish(String(data=json.dumps(out)))


def main():
    rclpy.init()
    n = CalibrationEval()
    try:
        rclpy.spin(n)
    except (KeyboardInterrupt, rclpy.executors.ExternalShutdownException):
        pass
    for name, e in sorted(n.last.get("lidars", {}).items()):
        ax = e.get("axis_err", [0] * 6)
        print(f"calibration_eval {name:12s} rot {e['rot_before_deg']:.2f} -> {e['rot_deg']:.3f} deg, "
              f"trans {e['trans_before_cm']:.1f} -> {e['trans_cm']:.2f} cm  "
              f"[droll {ax[0]:+.2f} dpitch {ax[1]:+.2f} dyaw {ax[2]:+.2f} deg, dx {ax[3]:+.1f} dy {ax[4]:+.1f} dz {ax[5]:+.1f} cm]",
              flush=True)


if __name__ == "__main__":
    main()
