Panels: []
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/MarkerArray
    Name: Ego
    Enabled: true
    Namespaces: {}
    Topic:
      Value: /viz/ego
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
    Value: true
  - Class: rviz_default_plugins/PointCloud2
    Name: Point-cloud map
    Enabled: true
    Alpha: 0.3
    Autocompute Intensity Bounds: false
    Min Intensity: 0
    Max Intensity: 100
    Channel Name: intensity
    Color Transformer: AxisColor
    Color: 255; 255; 255
    Decay Time: 0
    Position Transformer: XYZ
    Selectable: false
    Size (Pixels): 2
    Size (m): 0.25
    Style: Flat Squares
    Topic:
      Value: /map/pointcloud_map
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
    Use Fixed Frame: true
    Use rainbow: true
    Invert Rainbow: false
    Value: true
    Max Color: 255; 255; 255
    Min Color: 0; 0; 0
    Axis: Z
    Autocompute Value Bounds:
      Max Value: 12
      Min Value: -3
      Value: false
  - Class: rviz_default_plugins/Map
    Name: Site costmap
    Enabled: true
    Alpha: 0.35
    Color Scheme: map
    Draw Behind: false
    Binary representation: false
    Binary threshold: 100
    Topic:
      Value: /map/occupancy_grid
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
    Update Topic:
      Value: /map/occupancy_grid_updates
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Use Timestamp: false
    Value: true
  - Class: rviz_default_plugins/Path
    Name: Reference
    Enabled: true
    Alpha: 1.0
    Buffer Length: 1
    Color: 90; 170; 255
    Head Diameter: 0.3
    Head Length: 0.2
    Length: 0.3
    Line Style: Billboards
    Line Width: 0.35
    Offset:
      X: 0
      Y: 0
      Z: 0.0
    Pose Color: 255; 85; 255
    Pose Style: None
    Radius: 0.03
    Shaft Diameter: 0.1
    Shaft Length: 0.1
    Topic:
      Value: /control/reference
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
    Value: true
  - Class: rviz_default_plugins/Path
    Name: MPC horizon
    Enabled: true
    Alpha: 1.0
    Buffer Length: 1
    Color: 120; 255; 120
    Head Diameter: 0.3
    Head Length: 0.2
    Length: 0.3
    Line Style: Billboards
    Line Width: 0.5
    Offset:
      X: 0
      Y: 0
      Z: 0.0
    Pose Color: 255; 85; 255
    Pose Style: None
    Radius: 0.03
    Shaft Diameter: 0.1
    Shaft Length: 0.1
    Topic:
      Value: /control/predicted
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Value: true
  - Class: rviz_default_plugins/Path
    Name: Driven trail
    Enabled: true
    Alpha: 1.0
    Buffer Length: 1
    Color: 255; 255; 255
    Head Diameter: 0.3
    Head Length: 0.2
    Length: 0.3
    Line Style: Billboards
    Line Width: 0.3
    Offset:
      X: 0
      Y: 0
      Z: 0.0
    Pose Color: 255; 85; 255
    Pose Style: None
    Radius: 0.03
    Shaft Diameter: 0.1
    Shaft Length: 0.1
    Topic:
      Value: /control/trail
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Trajectory
    Enabled: true
    Namespaces: {}
    Topic:
      Value: /planning/markers
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
    Value: true
  - Class: rviz_2d_overlay_plugins/TextOverlay
    Name: HUD
    Enabled: true
    Topic:
      Value: /hud/control
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Value: true
    Overtake Position Properties: false
    Overtake FG Color Properties: false
    Overtake BG Color Properties: false
    Align Bottom: false
  Enabled: true
  Global Options:
    Background Color: 30; 34; 42
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools: []
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Distance: 48
      Focal Point:
        X: 6
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.01
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.05
      Pitch: 0.75
      Target Frame: base_link
      Value: ThirdPersonFollower (rviz_default_plugins)
      Yaw: 3.3
    Saved: null
Window Geometry:
  Height: 1189
  Width: 1970
  X: 0
  Y: 0
  Hide Left Dock: true
  Hide Right Dock: true
