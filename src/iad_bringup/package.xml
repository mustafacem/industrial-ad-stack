<?xml version="1.0"?>
<package format="3">
  <name>iad_bringup</name>
  <version>3.0.0</version>
  <description>Integration launch files for the demos: the Gazebo site + the standalone subsystem packages (each through
    its own launch file) + ground-truth evaluators + HUD + RViz.</description>
  <maintainer email="dev@example.com">iad</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>iad_gz_sim</exec_depend>
  <exec_depend>iad_perception</exec_depend>
  <exec_depend>iad_localization</exec_depend>
  <exec_depend>iad_calibration</exec_depend>
  <exec_depend>iad_planning</exec_depend>
  <exec_depend>iad_control</exec_depend>
  <exec_depend>iad_eval</exec_depend>
  <exec_depend>iad_tools</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
