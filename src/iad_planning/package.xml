<?xml version="1.0"?>
<package format="3">
  <name>iad_planning</name>
  <version>3.0.0</version>
  <description>Standalone free-space planning for unstructured sites: Hybrid A* with Reeds-Shepp analytic
    expansion, shortcutting, steering-rate-aware velocity profile, stop-and-replan for blocked paths, route mode.
    In: nav_msgs/OccupancyGrid (site file + live), nav_msgs/Odometry, PoseStamped goal or nav_msgs/Path route.
    Out: autoware_planning_msgs/Trajectory.</description>
  <maintainer email="dev@example.com">iad</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>autoware_planning_msgs</depend>
  <depend>autoware_perception_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>eigen</depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>python3-numpy</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
